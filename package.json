{
  "name": "node-red-contrib-sound-level",
  "version": "1.0.0",
  "description": "Node-RED node for sound level estimates: dB at a distance (inverse-square law with air absorption), distance for a target level, and combined levels of several sources.",
  "main": "nodes/sound-level.js",
  "files": [
    "nodes/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "mocha \"test/**/*_spec.js\" --exit"
  },
  "keywords": [
    "node-red",
    "sound",
    "decibel",
    "db",
    "spl",
    "noise",
    "acoustics",
    "inverse-square-law",
    "train-horn"
  ],
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "sound-level": "nodes/sound-level.js"
    }
  },
  "engines": {
    "node": ">=18.3"
  },
  "dependencies": {
    "trainhorn-calc": "^1.0.0"
  },
  "homepage": "https://train-horn.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/train-horn/node-red-contrib-sound-level.git"
  },
  "bugs": {
    "url": "https://github.com/train-horn/node-red-contrib-sound-level/issues"
  },
  "author": "Train Horn (https://train-horn.com/)",
  "license": "MIT",
  "devDependencies": {
    "mocha": "^12.0.3",
    "node-red": "^5.0.10",
    "node-red-node-test-helper": "^0.3.6"
  }
}
